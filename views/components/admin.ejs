<div id="adminPanel" style="display:none">
    <div class="glass-panel fade-in" style="display:flex; gap:15px; margin-bottom:20px; padding:15px; overflow-x:auto;">
      <button class="stage-btn active" onclick="switchAdminTab('overview')" id="btn-admin-overview">📊 Dashboard Overview</button>
      <button class="stage-btn" onclick="switchAdminTab('timetable')" id="btn-admin-timetable">📅 Timetable & Course Materials</button>
      <button class="stage-btn" onclick="switchAdminTab('grading')" id="btn-admin-grading">📝 Assignments & Grading</button>
      <button class="stage-btn" onclick="switchAdminTab('invoice')" id="btn-admin-invoice">🧾 Invoice & Receipts</button>
      <button class="stage-btn" onclick="switchAdminTab('builder')" id="btn-admin-builder">🏗️ Course Builder</button>
    </div>

    <div id="admin-tab-overview" class="admin-panel glass-panel fade-in">
       <!-- Loaded dynamically -->
    </div>

    <div id="admin-tab-timetable" class="glass-panel fade-in" style="display:none; padding:30px;">
       <h3 style="margin-bottom:20px; color:#fff; font-size:24px;">📅 Timetable & Course Materials</h3>
       
       <div style="background:rgba(0,0,0,0.2); padding:20px; border-radius:15px; border:1px solid rgba(255,255,255,0.1); margin-bottom:30px;">
         <h4 style="color:#38bdf8; margin-bottom:15px;">Add New Course Material to Timetable</h4>
         <div style="display:flex; gap:15px; flex-wrap:wrap;">
           <div style="flex:1; min-width:200px;">
             <label style="color:#cbd5e1; font-size:14px;">Select Student</label>
             <select id="ttStudent" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);"></select>
           </div>
           <div style="flex:1; min-width:200px;">
             <label style="color:#cbd5e1; font-size:14px;">Date & Time</label>
             <input type="datetime-local" id="ttDate" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
           </div>
         </div>
         <div style="display:flex; gap:15px; flex-wrap:wrap; margin-top:15px;">
           <div style="flex:2; min-width:300px;">
             <label style="color:#cbd5e1; font-size:14px;">Course Material / Topic Name</label>
             <input type="text" id="ttTopic" placeholder="e.g. Introduction to CSS" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
           </div>
           <div style="flex:2; min-width:300px;">
             <label style="color:#cbd5e1; font-size:14px;">Resource Link (Zoom/PDF/Video)</label>
             <input type="text" id="ttLink" placeholder="https://..." style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
           </div>
         </div>
         <button onclick="addTimetableEntry()" style="margin-top:20px; padding:12px 25px; background:#4ade80; color:white; border:none; border-radius:8px; cursor:pointer; font-weight:bold;">➕ Schedule Material</button>
       </div>
       
       <h4 style="color:#fff; margin-bottom:15px;">Global Timetable</h4>
       <div id="adminTimetableList" style="display:flex; flex-direction:column; gap:15px;"></div>
    </div>
    
    <div id="admin-tab-grading" class="glass-panel fade-in" style="display:none; padding:30px;">
       <h3 style="margin-bottom:20px; color:#fff; font-size:24px;">📝 Assignments & Grading</h3>
       <div id="adminGradingContent" style="color:#cbd5e1;">Coming in next phase.</div>
    </div>
    
    <div id="admin-tab-invoice" class="glass-panel fade-in" style="display:none; padding:30px;">
       <h3 style="margin-bottom:20px; color:#fff; font-size:24px;">🧾 Invoice & Receipts Generator</h3>
       
       <div style="background:rgba(0,0,0,0.2); padding:20px; border-radius:15px; border:1px solid rgba(255,255,255,0.1); margin-bottom:30px;">
         <h4 style="color:#38bdf8; margin-bottom:15px;">Generate New Document</h4>
         
         <div style="display:flex; gap:15px; flex-wrap:wrap;">
           <div style="flex:1; min-width:200px;">
             <label style="color:#cbd5e1; font-size:14px;">Document Type</label>
             <select id="invType" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
               <option value="Invoice">Invoice</option>
               <option value="Receipt">Receipt</option>
             </select>
           </div>
           <div style="flex:1; min-width:200px;">
             <label style="color:#cbd5e1; font-size:14px;">Client / Student Name</label>
             <input type="text" id="invClient" placeholder="e.g. John Doe" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
           </div>
         </div>
         
         <div style="display:flex; gap:15px; flex-wrap:wrap; margin-top:15px;">
           <div style="flex:2; min-width:300px;">
             <label style="color:#cbd5e1; font-size:14px;">Work / Service Details</label>
             <input type="text" id="invDetails" placeholder="e.g. 1 Month HTML Tutoring" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
           </div>
           <div style="flex:1; min-width:150px;">
             <label style="color:#cbd5e1; font-size:14px;">Amount ($)</label>
             <input type="number" id="invAmount" placeholder="e.g. 500" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
           </div>
         </div>
         
         <button onclick="generateInvoicePDF()" style="margin-top:20px; padding:12px 25px; background:linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color:white; border:none; border-radius:8px; cursor:pointer; font-weight:bold; box-shadow:0 4px 15px rgba(245, 158, 11, 0.3); transition:transform 0.2s;">🖨️ Generate & Download PDF</button>
       </div>
    </div>

    <div id="admin-tab-builder" class="glass-panel fade-in" style="display:none; padding:30px;">
       <h3 style="margin-bottom:20px; color:#fff; font-size:24px;">🏗️ Curriculum Course Builder</h3>
       
       <div style="background:rgba(0,0,0,0.2); padding:20px; border-radius:15px; border:1px solid rgba(255,255,255,0.1); margin-bottom:30px;">
         <h4 style="color:#38bdf8; margin-bottom:15px;">Create a New Stage/Lesson</h4>
         <div style="display:flex; gap:15px; flex-wrap:wrap;">
           <div style="flex:1; min-width:200px;">
             <label style="color:#cbd5e1; font-size:14px;">Select Course</label>
             <select id="builderCourse" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);"></select>
           </div>
           <div style="flex:1; min-width:200px;">
             <label style="color:#cbd5e1; font-size:14px;">Module Name</label>
             <input type="text" id="builderModule" placeholder="e.g. 1. HTML Basics" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
           </div>
         </div>
         <div style="display:flex; gap:15px; flex-wrap:wrap; margin-top:15px;">
           <div style="flex:1; min-width:200px;">
             <label style="color:#cbd5e1; font-size:14px;">Stage Title</label>
             <input type="text" id="builderTitle" placeholder="e.g. 1.1 The Body Tag" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
           </div>
         </div>
         <div style="margin-top:15px;">
           <label style="color:#cbd5e1; font-size:14px;">Question / Instruction</label>
           <textarea id="builderQuestion" placeholder="Explain what the student needs to do..." style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2); min-height:80px;"></textarea>
         </div>
         <div style="margin-top:15px;">
           <label style="color:#cbd5e1; font-size:14px;">Hint</label>
           <input type="text" id="builderHint" placeholder="e.g. Use the <body> tag." style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
         </div>
         <div style="margin-top:15px;">
           <label style="color:#cbd5e1; font-size:14px;">Required Elements (Comma separated)</label>
           <input type="text" id="builderReq" placeholder="e.g. <body>,Hello World,</body>" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
         </div>
         <div style="margin-top:15px;">
           <label style="color:#cbd5e1; font-size:14px;">Sample Solution (HTML)</label>
           <textarea id="builderSolution" placeholder="<body>\n  Hello World\n</body>" style="width:100%; padding:10px; margin-top:5px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2); min-height:100px; font-family:monospace;"></textarea>
         </div>
         
         <button onclick="createNewStage()" style="margin-top:20px; padding:12px 25px; background:linear-gradient(135deg, #22c55e 0%, #16a34a 100%); color:white; border:none; border-radius:8px; cursor:pointer; font-weight:bold; box-shadow:0 4px 15px rgba(34, 197, 94, 0.3); transition:transform 0.2s;">➕ Add Stage to Database</button>
       </div>
    </div>

  </div>