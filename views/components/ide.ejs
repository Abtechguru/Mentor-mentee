<div id="tab-ide" class="glass-panel fade-in" style="display:none; padding:20px; height: 80vh;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
    <h3 style="color:#fff; font-size:24px;">🖥️ Pro IDE & Live Classroom</h3>
    <div style="display:flex; gap:10px;">
      <input type="text" id="ideClassLink" placeholder="Enter Zoom/Meet Link..." style="padding:10px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2); width:300px;">
      <button onclick="loadClassroomIframe()" style="padding:10px 15px; background:#3b82f6; color:white; border:none; border-radius:8px; cursor:pointer;">Load Class</button>
      <button onclick="toggleIdeLayout()" style="padding:10px 15px; background:rgba(255,255,255,0.1); color:white; border:1px solid rgba(255,255,255,0.2); border-radius:8px; cursor:pointer;">↕️ Toggle Expand</button>
    </div>
  </div>

  <div id="ideWorkspace" style="display:flex; gap:20px; height: calc(100% - 60px);">
    <!-- Left: Classroom Video -->
    <div id="ideVideoPanel" style="flex:1; background:rgba(0,0,0,0.4); border-radius:15px; border:1px solid rgba(255,255,255,0.1); overflow:hidden; display:flex; flex-direction:column;">
      <div style="padding:10px; background:rgba(255,255,255,0.05); color:#94a3b8; font-size:14px; text-align:center;">🎥 Live Class Feed</div>
      <iframe id="ideIframe" src="about:blank" style="flex:1; width:100%; border:none;" allow="camera; microphone; fullscreen; display-capture"></iframe>
    </div>

    <!-- Right: Code Editor -->
    <div id="ideEditorPanel" style="flex:1; display:flex; flex-direction:column; background:rgba(0,0,0,0.4); border-radius:15px; border:1px solid rgba(255,255,255,0.1); overflow:hidden;">
      <div style="padding:10px; background:rgba(255,255,255,0.05); display:flex; justify-content:space-between; align-items:center;">
        <select id="ideLanguage" style="padding:8px; border-radius:5px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2);">
          <option value="html">HTML</option>
          <option value="css">CSS</option>
          <option value="python">Python</option>
          <option value="java">Java</option>
        </select>
        
        <div style="display:flex; gap:10px;">
          <button onclick="exportIdeCode()" style="padding:8px 12px; background:#10b981; color:white; border:none; border-radius:5px; cursor:pointer; font-size:12px;">💾 Export File</button>
          
          <!-- Student Actions -->
          <div class="student-only" style="display:none;">
            <select id="ideAssignmentSelect" style="padding:8px; border-radius:5px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2); max-width:150px;"></select>
            <button onclick="submitIdeAssignment()" style="padding:8px 12px; background:#8b5cf6; color:white; border:none; border-radius:5px; cursor:pointer; font-size:12px;">📤 Submit to Mentor</button>
          </div>
          
          <!-- Mentor Actions -->
          <div class="admin-only" style="display:none;">
            <select id="ideMenteeSelect" style="padding:8px; border-radius:5px; background:rgba(0,0,0,0.5); color:white; border:1px solid rgba(255,255,255,0.2); max-width:150px;"></select>
            <button onclick="sendCodeToMentee()" style="padding:8px 12px; background:#f59e0b; color:white; border:none; border-radius:5px; cursor:pointer; font-size:12px;">📩 Send Code to Student</button>
          </div>
        </div>
      </div>
      
      <div id="proCodeEditor" style="flex:1; width:100%; font-family:'Fira Code', monospace; font-size:16px;"></div>
    </div>
  </div>
</div>
