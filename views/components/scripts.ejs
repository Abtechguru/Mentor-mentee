  async function loadStudentContent() {
    try {
      const res = await fetch(`/api/progress/${currentUser.id}`);
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || 'Failed to load progress');
      
      userProgress = data.progress;
      allStages = data.stages;
      currentStageDetails = data.currentStageData;
      
      if (userProgress.streakCount > 0) {
        document.getElementById('streakDisplay').style.display = 'inline-block';
        document.getElementById('streakDisplay').textContent = `≡ƒöÑ ${userProgress.streakCount} Day Streak!`;
      } else {
        document.getElementById('streakDisplay').style.display = 'none';
      }
      
      renderStageButtons();
      renderStageContent();
      
      if (!aceEditorSandbox) {
        aceEditorSandbox = ace.edit("codeEditor");
        aceEditorSandbox.setTheme("ace/theme/tomorrow_night_eighties");
        aceEditorSandbox.session.setMode("ace/mode/html");
        aceEditorSandbox.setOptions({
          enableBasicAutocompletion: true,
          enableLiveAutocompletion: true,
          showPrintMargin: false,
          fontSize: "16px"
        });
        
        aceEditorSandbox.session.on('change', function() {
          updatePreview(aceEditorSandbox.getValue());
        });
      }
      // Calculate Analytics & Badges
      const proficiency = Math.round((userProgress.completedStages.length / allStages.length) * 100);
      document.getElementById('analyticsProficiency').innerText = proficiency + '%';
      
      let totalAttempts = 0;
      for (const stageId in userProgress.attempts) {
          totalAttempts += userProgress.attempts[stageId];
      }
      
      const speed = userProgress.completedStages.length > 0 ? (totalAttempts / userProgress.completedStages.length).toFixed(1) : 0;
      document.getElementById('analyticsSpeed').innerText = speed > 0 ? speed + ' tries/stage' : '-';
      
      let insight = 'Keep coding to generate insights!';
      if (speed > 3) {
          insight = '💡 You tend to use trial-and-error. Take more time to read the hints and review the lesson before submitting!';
      } else if (speed > 0 && speed <= 3) {
          insight = '🚀 Excellent learning speed! You are grasping the concepts efficiently.';
      }
      document.getElementById('analyticsInsights').innerText = insight;
      
      const badgesList = document.getElementById('badgesList');
      badgesList.innerHTML = '';
      if (userProgress.completedStages.length >= 1) {
          badgesList.innerHTML += '<div style="background:linear-gradient(135deg, #10b981, #059669); padding:10px 15px; border-radius:10px; color:white; font-weight:bold; font-size:14px; box-shadow:0 4px 10px rgba(16,185,129,0.3);">👶 First Steps</div>';
      }
      if (userProgress.completedStages.length >= 3) {
          badgesList.innerHTML += '<div style="background:linear-gradient(135deg, #3b82f6, #2563eb); padding:10px 15px; border-radius:10px; color:white; font-weight:bold; font-size:14px; box-shadow:0 4px 10px rgba(59,130,246,0.3);">🚀 Rapid Learner</div>';
      }
      if (userProgress.completedStages.length === allStages.length && allStages.length > 0) {
          badgesList.innerHTML += '<div style="background:linear-gradient(135deg, #f59e0b, #d97706); padding:10px 15px; border-radius:10px; color:white; font-weight:bold; font-size:14px; box-shadow:0 4px 10px rgba(245,158,11,0.3);">🏆 HTML Master</div>';
      }
      if (badgesList.innerHTML === '') badgesList.innerHTML = '<span style="color:#64748b;">Complete stages to earn badges!</span>';
      
      switchTab('sandbox');
    } catch(err) {
      console.error(err);
      alert("Error in loadStudentContent: " + err.message);
    }
  }

  function renderStageButtons() {
    const container = document.getElementById('stageButtons');
    container.innerHTML = '';
    
    let currentModule = '';
    let moduleContainer = null;
    
    allStages.forEach((stage, idx) => {
      if (stage.module !== currentModule) {
        currentModule = stage.module;
        
        const modTitle = document.createElement('h4');
        modTitle.textContent = currentModule;
        modTitle.style.width = '100%';
        modTitle.style.marginTop = '15px';
        modTitle.style.marginBottom = '5px';
        modTitle.style.color = '#764ba2';
        modTitle.style.borderBottom = '1px solid #ddd';
        modTitle.style.paddingBottom = '5px';
        
        moduleContainer = document.createElement('div');
        moduleContainer.style.display = 'flex';
        moduleContainer.style.gap = '10px';
        moduleContainer.style.flexWrap = 'wrap';
        moduleContainer.style.width = '100%';
        moduleContainer.style.marginBottom = '10px';
        
        container.appendChild(modTitle);
        container.appendChild(moduleContainer);
      }
      
      const btn = document.createElement('button');
      btn.textContent = `${stage.title}`;
      btn.className = 'stage-btn';
      if (userProgress.completedStages.includes(idx)) {
        btn.classList.add('completed');
      }
      if (idx === userProgress.currentStage) {
        btn.classList.add('active');
      }
      if (idx > userProgress.currentStage && !userProgress.completedStages.includes(idx-1) && idx !== 0) {
        btn.classList.add('locked');
        btn.disabled = true;
      }
      btn.onclick = async () => {
        if (idx <= userProgress.currentStage || userProgress.completedStages.includes(idx-1)) {
          const res = await fetch('/api/setstage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: currentUser.id, stageId: idx })
          });
          if(res.ok) {
            loadStudentContent();
          }
        }
      };
      if (moduleContainer) {
        moduleContainer.appendChild(btn);
      } else {
        container.appendChild(btn);
      }
    });
  }

  function renderStageContent() {
    document.getElementById('questionText').innerHTML = `<strong>${currentStageDetails.title}</strong><br><br>${currentStageDetails.question}`;
    document.getElementById('hintText').innerHTML = `≡ƒÆí Hint: ${currentStageDetails.hint}`;
    document.getElementById('attemptsText').innerHTML = `Attempts: ${currentStageDetails.attemptCount}`;
    
    // Check if there's a saved answer
    const savedAnswer = userProgress.answers[userProgress.currentStage];
    let editorValue = "";
    
    if (savedAnswer) {
      editorValue = savedAnswer;
    } else if (currentStageDetails.sampleSolution && currentStageDetails.attemptCount >= 3) {
      editorValue = currentStageDetails.sampleSolution;
    } else {
      editorValue = "<!DOCTYPE html>\n<html>\n<head>\n  <title>Your Title</title>\n</head>\n<body>\n\n</body>\n</html>";
    }
    
    if (aceEditorSandbox) {
        aceEditorSandbox.setValue(editorValue, -1);
    } else {
        document.getElementById('codeEditor').value = editorValue;
    }
    updatePreview(editorValue);
    
    document.getElementById('feedback').innerHTML = '';
    document.getElementById('feedback').className = 'feedback show';
    
    if (currentStageDetails.attemptCount >= 3) {
        if (!userProgress.completedStages.includes(userProgress.currentStage)) {
            document.getElementById('feedback').innerHTML = 'Γä╣∩╕Å You have tried 3 times. We provided the sample solution to help you learn! Modify it and test your code again to pass.';
            document.getElementById('feedback').className = 'feedback show info';
            if (!savedAnswer) {
                if (aceEditorSandbox) aceEditorSandbox.setValue(currentStageDetails.sampleSolution, -1);
                updatePreview(currentStageDetails.sampleSolution);
            }
        }
    }
  }

  function updatePreview(code) {
    const previewDiv = document.getElementById('livePreview');
    previewDiv.innerHTML = code;
  }

  async function checkAnswer() {
    const code = aceEditorSandbox ? aceEditorSandbox.getValue() : document.getElementById('codeEditor').value;
    try {
      const res = await fetch('/api/attempt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: currentUser.id, code })
      });
      const data = await res.json();
      
      if (data.success) {
        userProgress.completedStages = data.completedStages;
        document.getElementById('feedback').innerHTML = data.message;
        document.getElementById('feedback').className = 'feedback show success';
        renderStageButtons();
      } else {
        document.getElementById('feedback').innerHTML = data.message;
        document.getElementById('feedback').className = 'feedback show error';
        
        // Update attempt count
        currentStageDetails.attemptCount = data.attemptCount;
        document.getElementById('attemptsText').innerHTML = `Attempts: ${currentStageDetails.attemptCount}`;
        
        if (data.solution) {
          document.getElementById('feedback').innerHTML += '<br>✅ You have tried 3 times. We have injected the sample solution into your editor to help you.';
          if (aceEditorSandbox) aceEditorSandbox.setValue(data.solution, -1);
          updatePreview(data.solution);
          currentStageDetails.sampleSolution = data.solution;
        }
      }
    } catch(err) {
      console.error(err);
    }
  }

