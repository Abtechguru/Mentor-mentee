  // --- AI Chat Logic ---
  let aiChatHistory = [];
  let adminAiChatHistory = [];

  function addChatMessage(listId, role, text) {
    const list = document.getElementById(listId);
    const isUser = role === 'user';
    const bg = isUser ? 'rgba(99, 102, 241, 0.2)' : 'rgba(255, 255, 255, 0.1)';
    const align = isUser ? 'flex-end' : 'flex-start';
    const name = isUser ? 'You' : (listId === 'aiMessageList' ? '[MENTOR]' : '[MENTEE]');
    
    // Parse markdown-like code blocks for display
    let formattedText = text.replace(/```(.*?)\n([\s\S]*?)```/g, '<pre style="background:#1e1e1e; padding:10px; border-radius:5px; margin:10px 0;"><code>$2</code></pre>');
    formattedText = formattedText.replace(/\n/g, '<br>');

    list.innerHTML += `
      <div style="align-self:${align}; background:${bg}; padding:12px 18px; border-radius:15px; ${isUser ? 'border-bottom-right-radius:5px' : 'border-bottom-left-radius:5px'}; max-width:80%; color:#e2e8f0; line-height:1.5;">
        <strong style="color:${isUser ? '#818cf8' : '#34d399'};">${name}</strong><br>${formattedText}
      </div>
    `;
    list.scrollTop = list.scrollHeight;
  }

  async function sendAiMessage() {
    const input = document.getElementById('aiMessageInput');
    const text = input.value.trim();
    if (!text) return;
    
    input.value = '';
    addChatMessage('aiMessageList', 'user', text);
    aiChatHistory.push({ role: 'user', text });

    addChatMessage('aiMessageList', 'model', '<em>Thinking...</em>');
    const list = document.getElementById('aiMessageList');
    const typingIndicator = list.lastElementChild;

    try {
      const res = await fetch('/api/ask-ai', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, userRole: 'student', history: aiChatHistory })
      });
      const data = await res.json();
      
      typingIndicator.remove();
      
      if (data.answer) {
        addChatMessage('aiMessageList', 'model', data.answer);
        aiChatHistory.push({ role: 'model', text: data.answer });
      } else {
        addChatMessage('aiMessageList', 'model', 'Sorry, I encountered an error.');
      }
    } catch (err) {
      typingIndicator.remove();
      addChatMessage('aiMessageList', 'model', 'Connection error.');
    }
  }

