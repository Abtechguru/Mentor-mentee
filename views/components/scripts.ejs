            ${s.family_name ? `<div style="font-size:12px; color:#94a3b8; font-weight:normal;">Family: ${s.family_name} (${s.family_email})</div>` : ''}
            ${s.bio ? `<div style="font-size:12px; color:#94a3b8; font-weight:normal; font-style:italic;">"${s.bio}"</div>` : ''}
          </div>
        </div>
      `;
    }
    
    // Fetch messages between currentUser and menteeId
    const res = await fetch(`/api/messages/${menteeId}`);
    const data = await res.json();
    const msgList = document.getElementById('adminRealMessageList');
    msgList.innerHTML = '';

    const relevantMsgs = data.messages.filter(m => 
      (m.senderId === currentUser.id && m.receiverId === menteeId) ||
      (m.senderId === menteeId && m.receiverId === currentUser.id)
    );

    if(relevantMsgs.length === 0) {
      msgList.innerHTML = '<div style="text-align:center; color:#94a3b8; margin-top:20px;">No messages yet. Send a greeting! 👋</div>';
      return;
    }

    relevantMsgs.forEach(msg => {
      const isMine = msg.senderId === currentUser.id;
      const align = isMine ? 'align-self:flex-end; background:linear-gradient(135deg, #6366f1, #8b5cf6);' : 'align-self:flex-start; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.05);';
      const borderRadius = isMine ? '15px 15px 0 15px' : '15px 15px 15px 0';
      const senderName = isMine ? 'You' : msg.senderName;

      const div = document.createElement('div');
      div.style = `max-width:70%; padding:12px 18px; border-radius:${borderRadius}; color:white; font-size:15px; line-height:1.5; ${align} box-shadow:0 4px 15px rgba(0,0,0,0.1);`;
      div.innerHTML = `
        <div style="font-size:11px; color:rgba(255,255,255,0.6); margin-bottom:5px; font-weight:600;">${senderName} - ${new Date(msg.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
        ${msg.content}
      `;
      msgList.appendChild(div);
    });
    msgList.scrollTop = msgList.scrollHeight;
  }

