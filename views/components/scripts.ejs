        <div class="info">
          <p><strong>Student Name:</strong> ${currentUser.name}</p>
          <p><strong>Date:</strong> ${today}</p>
          <p><strong>Stages Completed:</strong> ${completedCount} / ${totalStages}</p>
          <p><strong>Overall Progress:</strong> ${percentage}%</p>
        </div>
        <h3>Stage-wise Performance</h3>
        <table>
          <tr><th>Stage</th><th>Title</th><th>Status</th></tr>
          ${stagesDetails}
        </table>
        <div class="score">
          ${percentage === 100 ? '≡ƒÄë PERFECT SCORE! HTML MASTER! ≡ƒÄë' : 'Keep practicing! You\'re doing great!'}
        </div>
        <div class="footer">
          <p>Generated by ABTECH TUTOR - Your HTML Learning Platform</p>
          <p>┬⌐ 2026 ABTECH TUTOR | All Rights Reserved</p>
        </div>
      </body>
      </html>
    `);
    printWindow.document.close();
    printWindow.print();
  }
</script>
