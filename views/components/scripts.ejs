<script>
  let currentUser = JSON.parse(localStorage.getItem('abtech_currentUser'));
  let currentStageDetails = null; // Store fetched data
  let allStages = [];
  let userProgress = null;
  
  function switchTab(tabId) {
    const tabs = ['sandbox', 'profile', 'messages', 'schedule', 'assignments'];
    tabs.forEach(t => {
      document.getElementById('tab-' + t).style.display = 'none';
      document.getElementById('btn-' + t).classList.remove('active');
    });
    document.getElementById('tab-' + tabId).style.display = 'block';
    document.getElementById('btn-' + tabId).classList.add('active');
    
    if (tabId === 'profile') loadProfileTab();
    if (tabId === 'messages') loadMessagesTab();
    if (tabId === 'schedule') loadScheduleTab();
    if (tabId === 'assignments') loadAssignmentsTab();
  }

  async function loadScheduleTab() {
    if(!currentUser.mentorId && currentUser.role !== 'admin') {
      document.getElementById('scheduleList').innerHTML = '<div style="color:#f87171; font-weight:600;">ΓÜá∩╕Å Please assign a mentor in your Profile tab to view schedules.</div>';
      return;
    }
    
    const res = await fetch(`/api/schedules/${currentUser.id}/${currentUser.role}`);
    const data = await res.json();
    const list = document.getElementById('scheduleList');
    list.innerHTML = '';
    
    if(data.schedules.length === 0) {
      list.innerHTML = '<div style="color:#94a3b8;">No upcoming classes scheduled yet.</div>';
      return;
    }
    
    data.schedules.forEach(s => {
      let attendanceBtn = '';
      if(s.attendance === 'pending' && currentUser.role === 'student') {
         attendanceBtn = `<button onclick="markAttendance(${s.id}, 'present')" style="padding:10px 20px; background:#22c55e; color:white; border:none; border-radius:8px; cursor:pointer; font-weight:600; transition:transform 0.2s;">Γ£ï Mark Present</button>`;
      } else {
         const color = s.attendance === 'present' ? '#4ade80' : '#f59e0b';
         attendanceBtn = `<span style="color:${color}; font-weight:800; padding:10px; background:rgba(255,255,255,0.05); border-radius:8px;">Status: ${s.attendance.toUpperCase()}</span>`;
      }
      
      list.innerHTML += `
        <div style="background:rgba(0,0,0,0.2); padding:25px; border-radius:15px; border-left:5px solid #f59e0b; display:flex; justify-content:space-between; align-items:center; box-shadow:0 4px 15px rgba(0,0,0,0.1);">
          <div>
            <strong style="color:#f8fafc; font-size:20px;">${s.topic}</strong>
            <div style="color:#cbd5e1; font-size:15px; margin-top:8px;">≡ƒòÆ Scheduled Date: <strong>${s.date}</strong></div>
            <a href="${s.link}" target="_blank" style="color:#38bdf8; text-decoration:none; display:inline-block; margin-top:12px; font-weight:600; padding:8px 15px; background:rgba(56, 189, 248, 0.1); border-radius:8px;">≡ƒöù Join Video Meeting Link</a>
          </div>
          <div style="text-align:right;">
             ${attendanceBtn}
          </div>
        </div>
      `;
    });
  }
  
  async function markAttendance(id, status) {
    await fetch(`/api/schedules/${id}/attendance`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ attendance: status })
    });
    alert('Attendance successfully marked!');
    loadScheduleTab();
  }

  async function loadAssignmentsTab() {
    if(!currentUser.mentorId && currentUser.role !== 'admin') {
      document.getElementById('assignmentList').innerHTML = '<div style="color:#f87171; font-weight:600;">ΓÜá∩╕Å Please assign a mentor in your Profile tab to receive assignments.</div>';
      return;
    }
    
    const res = await fetch(`/api/assignments/${currentUser.id}/${currentUser.role}`);
    const data = await res.json();
    const list = document.getElementById('assignmentList');
    list.innerHTML = '';
    
    if(data.assignments.length === 0) {
      list.innerHTML = '<div style="color:#94a3b8;">No assignments posted yet. Enjoy your day!</div>';
      return;
    }
    
    data.assignments.forEach(task => {
      const submission = data.submissions.find(s => s.assignmentId === task.id);
      let statusHtml = '';
      
      if(submission) {
         statusHtml = `
           <div style="margin-top:20px; padding:20px; background:rgba(34,197,94,0.1); border:1px solid rgba(34,197,94,0.3); border-radius:12px;">
             <strong style="color:#4ade80; font-size:18px;">Γ£à Successfully Submitted</strong>
             ${submission.grade ? `<div style="margin-top:12px; color:#fff; font-size:16px;"><strong>Grade Received:</strong> <span style="color:#38bdf8;">${submission.grade}</span></div>` : '<div style="margin-top:10px; color:#cbd5e1;">Awaiting Grading...</div>'}
             ${submission.comment ? `<div style="color:#94a3b8; font-style:italic; margin-top:10px; border-left:3px solid #6366f1; padding-left:10px;">"Mentor says: ${submission.comment}"</div>` : ''}
           </div>
         `;
      } else {
         statusHtml = `
           <div style="margin-top:20px;">
             <label style="background:#6366f1; color:white; padding:12px 20px; border-radius:10px; cursor:pointer; font-size:15px; font-weight:bold; display:inline-block; transition:transform 0.2s;">
               ≡ƒôä Upload Submission (PDF/Image)
               <input type="file" style="display:none;" onchange="submitAssignment(event, ${task.id})">
             </label>
           </div>
         `;
      }
      
      list.innerHTML += `
        <div style="background:rgba(0,0,0,0.2); padding:25px; border-radius:15px; border:1px solid rgba(255,255,255,0.1); box-shadow:0 4px 15px rgba(0,0,0,0.1);">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong style="color:#38bdf8; font-size:20px;">${task.title}</strong>
            <span style="color:#f87171; font-size:14px; font-weight:800; background:rgba(239, 68, 68, 0.1); padding:8px 12px; border-radius:8px;">ΓÅ│ Due: ${task.dueDate}</span>
          </div>
          <p style="color:#e2e8f0; margin-top:15px; line-height:1.6; font-size:15px;">${task.description}</p>
          ${statusHtml}
        </div>
      `;
    });
  }
  
  function submitAssignment(event, assignmentId) {
    const file = event.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = async function(e) {
      const base64 = e.target.result;
      
      document.getElementById('assignmentList').innerHTML = '<div style="color:#38bdf8; font-weight:bold;">Uploading submission... please wait.</div>';
      
      await fetch('/api/submissions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ assignmentId, studentId: currentUser.id, fileData: base64, fileName: file.name })
      });
      alert('Assignment submitted successfully! Your mentor has been notified.');
      loadAssignmentsTab();
    };
    reader.readAsDataURL(file);
  }

  async function loadMessagesTab() {
    if(!currentUser.mentorId && currentUser.role !== 'admin') {
      document.getElementById('messageList').innerHTML = '<div style="text-align:center; color:#f87171; margin-top:20px; font-weight:600;">ΓÜá∩╕Å Please assign a mentor in your Profile tab first before messaging.</div>';
      return;
    }
    
    const res = await fetch(`/api/messages/${currentUser.id}`);
    const data = await res.json();
    const msgList = document.getElementById('messageList');
    msgList.innerHTML = '';
    
    if(data.messages.length === 0) {
      msgList.innerHTML = '<div style="text-align:center; color:#94a3b8; margin-top:20px;">No messages yet. Say hello! ≡ƒæï</div>';
      return;
    }
    
    data.messages.forEach(msg => {
      const isMine = msg.senderId === currentUser.id;
      const align = isMine ? 'align-self:flex-end; background:linear-gradient(135deg, #6366f1, #8b5cf6);' : 'align-self:flex-start; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.05);';
      const borderRadius = isMine ? '15px 15px 0 15px' : '15px 15px 15px 0';
      
      const div = document.createElement('div');
      div.style = `max-width:70%; padding:12px 18px; border-radius:${borderRadius}; color:white; font-size:15px; line-height:1.5; ${align} box-shadow:0 4px 15px rgba(0,0,0,0.1);`;
      div.innerHTML = `
        <div style="font-size:11px; color:rgba(255,255,255,0.6); margin-bottom:5px; font-weight:600;">${isMine ? 'You' : msg.senderName} - ${new Date(msg.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</div>
        ${msg.content}
      `;
      msgList.appendChild(div);
    });
    
    msgList.scrollTop = msgList.scrollHeight;
  }
  
  async function sendMessage() {
    const input = document.getElementById('messageInput');
    const content = input.value.trim();
    if(!content) return;
    
    let receiverId = currentUser.mentorId; 
    
    if (currentUser.role === 'admin') {
      alert("Advanced mentor chat view is coming in next phase. For now, mentors view chats globally.");
      return;
    }
    
    if(!receiverId) return alert('No mentor assigned.');
    
    input.value = '';
    
    const msgList = document.getElementById('messageList');
    if(msgList.innerHTML.includes('No messages yet')) msgList.innerHTML = '';
    const div = document.createElement('div');
    div.style = `max-width:70%; padding:12px 18px; border-radius:15px 15px 0 15px; color:white; font-size:15px; line-height:1.5; align-self:flex-end; background:linear-gradient(135deg, #6366f1, #8b5cf6); box-shadow:0 4px 15px rgba(0,0,0,0.1);`;
    div.innerHTML = `<div style="font-size:11px; color:rgba(255,255,255,0.6); margin-bottom:5px; font-weight:600;">You - Just now</div>${content}`;
    msgList.appendChild(div);
    msgList.scrollTop = msgList.scrollHeight;
    
    await fetch('/api/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ senderId: currentUser.id, receiverId, content })
    });
  }

  async function loadProfileTab() {
    document.getElementById('profileName').textContent = currentUser.name;
    document.getElementById('profileRole').textContent = currentUser.role === 'admin' ? 'Mentor' : 'Student';
    if(currentUser.profilePic) {
      document.getElementById('profileImageDisplay').src = currentUser.profilePic;
    } else {
      document.getElementById('profileImageDisplay').src = `https://ui-avatars.com/api/?name=${currentUser.name}&background=6366f1&color=fff`;
    }
    
    if (currentUser.role === 'admin') {
      document.getElementById('mentorDetails').innerHTML = '<p style="color:#4ade80;">You are a mentor! Students will assign themselves to you.</p>';
      return;
    }
    
    const res = await fetch('/api/mentors');
    const data = await res.json();
    const mentorDiv = document.getElementById('mentorDetails');
    
    if (currentUser.mentorId) {
      const myMentor = data.mentors.find(m => m.id === currentUser.mentorId);
      if(myMentor) {
        mentorDiv.innerHTML = `
          <div style="display:flex; flex-direction:column; gap:15px; background:rgba(255,255,255,0.05); padding:20px; border-radius:10px;">
            <div style="display:flex; align-items:center; gap:15px;">
              <img src="${myMentor.profilePic || `https://ui-avatars.com/api/?name=${myMentor.name}&background=8b5cf6&color=fff`}" style="width:80px; height:80px; border-radius:50%; object-fit:cover; border:2px solid #8b5cf6;">
              <div>
                <strong style="color:#fff; font-size:22px;">${myMentor.name}</strong>
                <div style="color:#38bdf8; font-size:14px; font-weight:600; margin-top:3px;">${myMentor.expertise || 'Mentor'}</div>
                <div style="color:#4ade80; font-size:12px; margin-top:5px;">✅ Assigned to you</div>
              </div>
            </div>
            ${myMentor.bio ? `<div style="background:rgba(0,0,0,0.3); padding:15px; border-radius:8px; font-size:14px; line-height:1.6; border-left:3px solid #6366f1;"><em>"${myMentor.bio}"</em></div>` : ''}
          </div>
          <button onclick="switchTab('messages')" style="margin-top:20px; width:100%; padding:12px; background:#3b82f6; color:white; border:none; border-radius:8px; cursor:pointer; font-weight:600; transition:transform 0.2s;">💬 Message Mentor</button>
        `;
      }
    } else {
      let html = `<p style="margin-bottom:15px; color:#f87171;">You do not have a mentor assigned yet. Please select one below:</p>`;
      html += `<select id="mentorSelect" style="width:100%; padding:12px; border-radius:8px; background:rgba(0,0,0,0.5); color:white; border:1px solid #4ade80; margin-bottom:15px;">`;
      html += `<option value="">-- Choose a Mentor --</option>`;
      data.mentors.forEach(m => {
        const expertiseStr = m.expertise ? ` - ${m.expertise}` : '';
        html += `<option value="${m.id}">${m.name}${expertiseStr}</option>`;
      });
      html += `</select>`;
      html += `<button onclick="assignMentor()" style="width:100%; padding:12px; background:#4ade80; color:white; border:none; border-radius:8px; cursor:pointer; font-weight:600; transition:transform 0.2s;">Assign Mentor</button>`;
      mentorDiv.innerHTML = html;
    }
  }

  function uploadProfilePic(event) {
    const file = event.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = async function(e) {
      const base64 = e.target.result;
      document.getElementById('profileImageDisplay').src = base64;
      currentUser.profilePic = base64;
      localStorage.setItem('abtech_currentUser', JSON.stringify(currentUser));
      
      await fetch('/api/users/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: currentUser.id, mentorId: currentUser.mentorId, profilePic: base64 })
      });
      alert('Profile picture updated successfully!');
    };
    reader.readAsDataURL(file);
  }

  async function assignMentor() {
    const mentorId = document.getElementById('mentorSelect').value;
    if(!mentorId) return alert('Please select a mentor.');
    
    currentUser.mentorId = parseInt(mentorId);
    localStorage.setItem('abtech_currentUser', JSON.stringify(currentUser));
    
    await fetch('/api/users/profile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId: currentUser.id, mentorId: currentUser.mentorId, profilePic: currentUser.profilePic })
    });
    
    loadProfileTab();
    alert('Mentor assigned successfully!');
  }
  
  if (currentUser) {
    showApp();
  }

  async function register() {
    const name = document.getElementById('regName').value;
    const password = document.getElementById('regPassword').value;
    if (!name || !password) return alert('Please fill all fields');
    
    try {
      const res = await fetch('/api/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, password, role: 'student' })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      alert('Registration successful! Please login.');
      showLogin();
    } catch(err) {
      alert(err.message);
    }
  }

  async function login() {
    const name = document.getElementById('loginName').value;
    const password = document.getElementById('loginPassword').value;
    const role = document.getElementById('loginRole').value;
    
    try {
      const res = await fetch('/api/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, password, role })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      
      currentUser = data.user;
      localStorage.setItem('abtech_currentUser', JSON.stringify(currentUser));
      showApp();
    } catch(err) {
      alert(err.message);
    }
  }

  function logout() {
    currentUser = null;
    localStorage.removeItem('abtech_currentUser');
    document.getElementById('authSection').style.display = 'block';
    document.getElementById('mainApp').style.display = 'none';
    document.getElementById('loginName').value = '';
    document.getElementById('loginPassword').value = '';
  }

  function showRegister() {
    document.getElementById('loginForm').style.display = 'none';
    document.getElementById('registerForm').style.display = 'block';
  }

  function showLogin() {
    document.getElementById('loginForm').style.display = 'block';
    document.getElementById('registerForm').style.display = 'none';
  }

  function showApp() {
    document.getElementById('authSection').style.display = 'none';
    document.getElementById('mainApp').style.display = 'block';
    document.getElementById('userNameDisplay').innerHTML = `≡ƒæñ ${currentUser.name}`;
    document.getElementById('userRoleDisplay').innerHTML = currentUser.role === 'admin' ? '≡ƒæ¿ΓÇì≡ƒÅ½ Mentor' : '≡ƒÄô Student';
    
    if (currentUser.role === 'admin') {
      document.getElementById('adminPanel').style.display = 'block';
      document.getElementById('studentContent').style.display = 'none';
      loadAdminPanel();
    } else {
      document.getElementById('adminPanel').style.display = 'none';
      document.getElementById('studentContent').style.display = 'block';
      loadStudentContent();
    }
  }

  let adminStudents = [];

  function switchAdminTab(tabId) {
    const tabs = ['overview', 'timetable', 'grading', 'invoice', 'builder', 'profile'];
    tabs.forEach(t => {
      document.getElementById('admin-tab-' + t).style.display = 'none';
      document.getElementById('btn-admin-' + t).classList.remove('active');
    });
    document.getElementById('admin-tab-' + tabId).style.display = 'block';
    document.getElementById('btn-admin-' + tabId).classList.add('active');
    
    if (tabId === 'overview') loadAdminPanel();
    if (tabId === 'timetable') loadAdminTimetableTab();
    if (tabId === 'builder') loadAdminBuilderTab();
    if (tabId === 'profile') loadAdminProfileTab();
  }

  async function loadAdminProfileTab() {
    const res = await fetch(`/api/users/me?userId=${currentUser.id}`);
    const data = await res.json();
    if (data.user) {
      document.getElementById('adminProfilePic').value = data.user.profilePic || '';
      document.getElementById('adminExpertise').value = data.user.expertise || '';
      document.getElementById('adminBio').value = data.user.bio || '';
    }
  }

  async function saveAdminProfile() {
    const profilePic = document.getElementById('adminProfilePic').value;
    const expertise = document.getElementById('adminExpertise').value;
    const bio = document.getElementById('adminBio').value;

    const res = await fetch('/api/users/profile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId: currentUser.id, profilePic, expertise, bio })
    });
    const data = await res.json();
    if (data.success) {
      alert('Profile saved successfully!');
    } else {
      alert('Failed to save profile');
    }
  }

  async function loadAdminBuilderTab() {
    const res = await fetch('/api/courses');
    const data = await res.json();
    const select = document.getElementById('builderCourse');
    select.innerHTML = '<option value="">-- Select a Course --</option>';
    data.courses.forEach(c => {
      select.innerHTML += `<option value="${c.id}">${c.title}</option>`;
    });
    // Add option to create new course
    select.innerHTML += '<option value="new">Γ₧ò Create New Course...</option>';
    
    select.onchange = async (e) => {
      if(e.target.value === 'new') {
        const title = prompt("Enter new Course Name:");
        if(!title) { select.value = ''; return; }
        const desc = prompt("Enter Course Description:");
        const res = await fetch('/api/courses', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, description: desc })
        });
        const data = await res.json();
        if(data.success) {
          alert('Course created successfully!');
          loadAdminBuilderTab();
        } else {
          alert('Failed to create course');
        }
      }
    };
  }

  async function createNewStage() {
    const courseId = document.getElementById('builderCourse').value;
    const moduleName = document.getElementById('builderModule').value;
    const title = document.getElementById('builderTitle').value;
    const question = document.getElementById('builderQuestion').value;
    const hint = document.getElementById('builderHint').value;
    const reqStr = document.getElementById('builderReq').value;
    const sampleSolution = document.getElementById('builderSolution').value;
    
    if(!courseId || courseId === 'new') return alert("Please select a valid course.");
    if(!moduleName || !title || !question || !reqStr || !sampleSolution) return alert("Please fill all required fields.");
    
    // We get current orderIndex by fetching stages length
    const resStages = await fetch('/api/admin/students');
    const dataStages = await resStages.json();
    const orderIndex = dataStages.totalStages;
    
    const requiredElements = reqStr.split(',').map(s => s.trim());
    
    const res = await fetch('/api/stages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        courseId: parseInt(courseId),
        module: moduleName,
        title, question, hint, requiredElements, sampleSolution, orderIndex
      })
    });
    const data = await res.json();
    if(data.success) {
      alert('New stage/lesson added successfully!');
      // Clear fields
      document.getElementById('builderTitle').value = '';
      document.getElementById('builderQuestion').value = '';
      document.getElementById('builderReq').value = '';
      document.getElementById('builderSolution').value = '';
    } else {
      alert('Failed to add stage: ' + (data.error?.message || 'Unknown error'));
    }
  }

  async function loadAdminPanel() {
    const res = await fetch('/api/admin/students');
    const data = await res.json();
    adminStudents = data.students;
    
    const adminPanel = document.getElementById('admin-tab-overview');
    
    // Calculate global stats
    const totalStudents = data.students.length;
    let totalCompletions = 0;
    data.students.forEach(s => totalCompletions += s.completedStages.length);
    const avgCompletions = totalStudents > 0 ? (totalCompletions / totalStudents).toFixed(1) : 0;
    
    adminPanel.innerHTML = `
      <h3>≡ƒæ¿ΓÇì≡ƒÅ½ Mentor Dashboard Overview</h3>
      <div style="display:flex; gap:20px; margin-bottom:30px; margin-top:20px; flex-wrap:wrap;">
        <div style="flex:1; min-width:200px; background:rgba(99,102,241,0.1); padding:20px; border-radius:15px; border:1px solid rgba(99,102,241,0.3); text-align:center;">
          <h2 style="color:#818cf8; font-size:36px;">${totalStudents}</h2>
          <p style="color:#cbd5e1; font-weight:600;">Total Students</p>
        </div>
        <div style="flex:1; min-width:200px; background:rgba(34,197,94,0.1); padding:20px; border-radius:15px; border:1px solid rgba(34,197,94,0.3); text-align:center;">
          <h2 style="color:#4ade80; font-size:36px;">${avgCompletions}</h2>
          <p style="color:#cbd5e1; font-weight:600;">Avg. Stages Passed</p>
        </div>
        <div style="flex:1; min-width:200px; background:rgba(245,158,11,0.1); padding:20px; border-radius:15px; border:1px solid rgba(245,158,11,0.3); text-align:center;">
          <h2 style="color:#fbbf24; font-size:36px;">${data.totalStages}</h2>
          <p style="color:#cbd5e1; font-weight:600;">Total Curriculum Stages</p>
        </div>
      </div>
      
      <h3>≡ƒôï Student Progress Details</h3>
      <div id="studentsList" class="students-list"></div>
    `;
    
    const studentsList = document.getElementById('studentsList');
    
    data.students.forEach(student => {
      const percentage = Math.round((student.completedStages.length / data.totalStages) * 100);
      
      const div = document.createElement('div');
      div.className = 'student-card';
      div.style.flexDirection = 'column';
      div.style.alignItems = 'stretch';
      
      let attemptsHtml = '';
      if(Object.keys(student.attempts).length > 0) {
        attemptsHtml = '<div style="margin-top:15px; padding-top:15px; border-top:1px solid rgba(255,255,255,0.1);"><h4 style="color:#38bdf8; margin-bottom:10px; font-size:14px;">Activity Log (Trials):</h4><div style="display:flex; gap:10px; flex-wrap:wrap;">';
        for(let stageId in student.attempts) {
           const attempts = student.attempts[stageId];
           const statusColor = student.completedStages.includes(parseInt(stageId)) ? '#4ade80' : '#f87171';
           attemptsHtml += `<span style="background:rgba(255,255,255,0.05); padding:5px 10px; border-radius:5px; font-size:12px; border-left:3px solid ${statusColor}; color:#e2e8f0;">Stage ${parseInt(stageId)+1}: ${attempts} tries</span>`;
        }
        attemptsHtml += '</div></div>';
      } else {
        attemptsHtml = '<div style="margin-top:15px; padding-top:15px; border-top:1px solid rgba(255,255,255,0.1); color:#64748b; font-size:13px;">No code submitted yet.</div>';
      }
      
      div.innerHTML = `
        <div style="display:flex; justify-content:space-between; align-items:center; width:100%;">
          <div>
            <strong style="font-size:18px; color:#f8fafc;">≡ƒæñ ${student.name}</strong>
            <div style="color:#94a3b8; font-size:14px; margin-top:5px;">Currently on Stage: ${student.currentStage + 1}</div>
          </div>
          <div style="text-align:right;">
            <div style="color:#4ade80; font-weight:800; font-size:20px;">${percentage}%</div>
            <div style="color:#94a3b8; font-size:12px;">Completed (${student.completedStages.length}/${data.totalStages})</div>
          </div>
        </div>
        
        <div style="width:100%; height:8px; background:rgba(255,255,255,0.1); border-radius:4px; margin-top:15px; overflow:hidden;">
          <div style="width:${percentage}%; height:100%; background:linear-gradient(90deg, #38bdf8, #818cf8); border-radius:4px; transition:width 1s ease-in-out;"></div>
        </div>
        
        ${attemptsHtml}
      `;
      studentsList.appendChild(div);
    });
  }

  async function loadAdminTimetableTab() {
    // Populate dropdown
    const select = document.getElementById('ttStudent');
    select.innerHTML = '<option value="">-- All Students --</option>';
    adminStudents.forEach(s => {
      select.innerHTML += `<option value="${s.id}">${s.name}</option>`;
    });

    // Fetch all schedules for admin
    const res = await fetch(`/api/schedules/${currentUser.id}/admin`);
    const data = await res.json();
    
    const list = document.getElementById('adminTimetableList');
    list.innerHTML = '';
    
    if(data.schedules.length === 0) {
      list.innerHTML = '<div style="color:#94a3b8;">No course materials scheduled yet.</div>';
      return;
    }
    
    data.schedules.forEach(s => {
      const student = adminStudents.find(st => st.id === s.studentId);
      const studentName = student ? student.name : 'All Students';
      const color = s.attendance === 'present' ? '#4ade80' : '#f59e0b';
      
      list.innerHTML += `
        <div style="background:rgba(255,255,255,0.05); padding:20px; border-radius:10px; border-left:4px solid #3b82f6; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <strong style="color:#38bdf8; font-size:18px;">${s.topic}</strong>
            <div style="color:#e2e8f0; font-size:14px; margin-top:5px;">≡ƒæñ Assigned to: <strong>${studentName}</strong></div>
            <div style="color:#94a3b8; font-size:14px; margin-top:3px;">≡ƒòÆ ${s.date}</div>
            <a href="${s.link}" target="_blank" style="color:#fbbf24; text-decoration:none; display:inline-block; margin-top:8px; font-weight:600;">≡ƒöù Open Material / Link</a>
          </div>
          <div style="text-align:right;">
             <span style="color:${color}; font-weight:bold; background:rgba(255,255,255,0.1); padding:5px 10px; border-radius:5px; margin-bottom:10px; display:inline-block;">Attendance: ${s.attendance.toUpperCase()}</span><br>
             <button onclick="deleteTimetableEntry(${s.id})" style="padding:5px 10px; background:#ef4444; color:white; border:none; border-radius:5px; cursor:pointer; font-size:12px;">≡ƒùæ∩╕Å Delete</button>
          </div>
        </div>
      `;
    });
  }

  async function deleteTimetableEntry(id) {
    if(!confirm("Are you sure you want to delete this course material from the timetable?")) return;
    await fetch(`/api/schedules/${id}`, { method: 'DELETE' });
    loadAdminTimetableTab();
  }

  async function addTimetableEntry() {
    const studentId = document.getElementById('ttStudent').value;
    const date = document.getElementById('ttDate').value;
    const topic = document.getElementById('ttTopic').value;
    const link = document.getElementById('ttLink').value;
    
    if(!topic || !date || !link) {
      return alert('Please fill in Date, Topic, and Link!');
    }
    
    // In this basic implementation, if studentId is empty, it assigns to a generic student ID, or we could handle broadcasting.
    // Let's assume studentId is required for now.
    if(!studentId) return alert('Please select a specific student to assign this material to.');

    await fetch('/api/schedules', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mentorId: currentUser.id, studentId, topic, date, link })
    });
    
    alert('Course material successfully scheduled!');
    document.getElementById('ttTopic').value = '';
    document.getElementById('ttLink').value = '';
    document.getElementById('ttDate').value = '';
    loadAdminTimetableTab();
  }

