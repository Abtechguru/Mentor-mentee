  }
  async function generateWeeklySummaries() {
    const btn = document.getElementById('btnGenSummaries');
    const resultDiv = document.getElementById('summaryResults');
    
    btn.innerHTML = '⏳ Generating...';
    btn.disabled = true;
    resultDiv.style.display = 'block';
    resultDiv.innerHTML = 'Analyzing student data and sending emails to families...';

    try {
      const res = await fetch('/api/admin/generate-summaries', { method: 'POST' });
      const data = await res.json();
      
      if(data.success) {
        resultDiv.innerHTML = `<span style="color:#4ade80; font-weight:bold;">✅ Success! Summaries generated and "sent" to families.</span>\n\n`;
        data.logs.forEach(log => {
          resultDiv.innerHTML += `<strong>To: ${log.family_email} (${log.family_name})</strong> regarding ${log.studentName}:\n${log.summary}\n\n---\n\n`;
        });
      } else {
        resultDiv.innerHTML = `<span style="color:#f87171;">Failed to generate summaries: ${data.error}</span>`;
      }
    } catch(e) {
      resultDiv.innerHTML = `<span style="color:#f87171;">Connection error.</span>`;
    }

    btn.innerHTML = '📧 Generate Weekly Family Summaries';
    btn.disabled = false;
  }
  async function requestSession() {
    const date = document.getElementById('bookDate').value;
    const topic = document.getElementById('bookTopic').value;
    
    if(!date || !topic) return alert('Please provide date and topic');
    
    if(!currentUser.mentorId) {
       return alert('You must assign a mentor in your profile first!');
    }

    await fetch('/api/schedules', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mentorId: currentUser.mentorId, studentId: currentUser.id, topic, date, link: 'Pending Mentor Approval', attendance: 'requested' })
    });
    
    alert('Session requested successfully! Your mentor will review it.');
    document.getElementById('bookDate').value = '';
    document.getElementById('bookTopic').value = '';
    
    // Refresh student schedule tab if possible
    const btn = document.getElementById('btn-schedule');
    if(btn) btn.click();
  }

  function toggleNotifications() {
    const dropdown = document.getElementById('notifDropdown');
    dropdown.style.display = dropdown.style.display === 'none' ? 'flex' : 'none';
  }

  async function loadNotifications() {
    try {
      const list = document.getElementById('notifList');
      const badge = document.getElementById('notifBadge');
      list.innerHTML = '';
      let notifCount = 0;
      
      if(currentUser.role === 'admin') {
         // Mentor Notifications
         const res = await fetch(`/api/schedules/${currentUser.id}/admin`);
         const data = await res.json();
         const pendingSchedules = (data.schedules || []).filter(s => s.attendance === 'requested');
         pendingSchedules.forEach(s => {
            notifCount++;
            list.innerHTML += `<div style="padding:10px; background:rgba(245,158,11,0.2); border-radius:8px; border-left:3px solid #f59e0b;">📅 Mentee ${s.studentName || 'Student'} requested a session for ${new Date(s.date).toLocaleDateString()}</div>`;
         });
         
         const assignRes = await fetch(`/api/assignments/${currentUser.id}/admin`);
         const assignData = await assignRes.json();
         const pendingGrades = (assignData.submissions || []).filter(s => s.grade === null);
         if(pendingGrades.length > 0) {
            notifCount++;
            list.innerHTML += `<div style="padding:10px; background:rgba(139,92,246,0.2); border-radius:8px; border-left:3px solid #8b5cf6;">📝 You have ${pendingGrades.length} ungraded assignments!</div>`;
         }
      } else {
         // Student Notifications
         const res = await fetch(`/api/schedules/${currentUser.id}/student`);
         const data = await res.json();
         const upcomingClasses = (data.schedules || []).filter(s => s.attendance !== 'requested' && new Date(s.date) > new Date());
         if(upcomingClasses.length > 0) {
            notifCount++;
            list.innerHTML += `<div style="padding:10px; background:rgba(16,185,129,0.2); border-radius:8px; border-left:3px solid #10b981;">🎥 You have ${upcomingClasses.length} upcoming live classes!</div>`;
         }
         
         const assignRes = await fetch(`/api/assignments/${currentUser.id}/student`);
         const assignData = await assignRes.json();
         const newGrades = (assignData.submissions || []).filter(s => s.grade !== null);
         if(newGrades.length > 0) {
            notifCount++;
            list.innerHTML += `<div style="padding:10px; background:rgba(56,189,248,0.2); border-radius:8px; border-left:3px solid #38bdf8;">🏆 You have received grades for ${newGrades.length} assignments.</div>`;
         }
      }
      
      if(notifCount > 0) {
        badge.style.display = 'block';
        badge.innerText = notifCount;
      } else {
        badge.style.display = 'none';
        list.innerHTML = '<div style="color:#64748b;">No new notifications.</div>';
      }
    } catch(err) {}
  }

  async function loadCommunityTab() {
    try {
      // Load Leaderboard
      const res = await fetch('/api/admin/students');
      const data = await res.json();
      
      const sortedStudents = (data.students || []).sort((a,b) => b.completedStages.length - a.completedStages.length).slice(0, 5);
      const lb = document.getElementById('communityLeaderboard');
      if(lb) {
        lb.innerHTML = '';
        sortedStudents.forEach((s, idx) => {
          let rankIcon = ['🥇','🥈','🥉'][idx] || `<strong style="color:#94a3b8;">#${idx+1}</strong>`;
          lb.innerHTML += `<div style="display:flex; justify-content:space-between; align-items:center; background:rgba(255,255,255,0.05); padding:10px; border-radius:8px;">
            <div style="display:flex; align-items:center; gap:10px;">
               <span style="font-size:18px;">${rankIcon}</span>
               <img src="${s.profilePic || 'https://ui-avatars.com/api/?name='+s.name+'&background=random'}" style="width:30px; height:30px; border-radius:50%;">
               <span style="color:#e2e8f0; font-weight:bold;">${s.name}</span>
            </div>
            <span style="color:#f59e0b; font-weight:bold;">${s.completedStages.length} Stages</span>
          </div>`;
        });
        if(sortedStudents.length === 0) lb.innerHTML = '<div style="color:#94a3b8;">No learners yet!</div>';
      }

      // Load Marketplace
      const mentorRes = await fetch('/api/mentors');
      const mentorData = await mentorRes.json();
      
      const mp = document.getElementById('communityMarketplace');
      if(mp) {
        mp.innerHTML = '';
        (mentorData.mentors || []).forEach(m => {
          mp.innerHTML += `<div style="background:rgba(255,255,255,0.05); padding:15px; border-radius:8px; display:flex; justify-content:space-between; align-items:center;">
             <div>
               <strong style="color:#f8fafc; font-size:16px;">${m.name}</strong>
               <div style="color:#10b981; font-size:12px; margin-top:2px;">Expertise: ${m.expertise || 'General Programming'}</div>
               ${m.bio ? `<div style="color:#94a3b8; font-size:12px; margin-top:5px; font-style:italic;">"${m.bio}"</div>` : ''}
             </div>
             <button onclick="switchTab('profile')" style="padding:8px 15px; background:#10b981; color:white; border:none; border-radius:8px; cursor:pointer; font-weight:bold; font-size:12px;">Go to Profile</button>
          </div>`;
        });
      }
    } catch(err) {
      console.error(err);
    }
  }
</script>
</body>