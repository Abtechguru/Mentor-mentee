  async function createNewStage() {
    const courseId = document.getElementById('builderCourse').value;
    const moduleName = document.getElementById('builderModule').value;
    const title = document.getElementById('builderTitle').value;
    const question = document.getElementById('builderQuestion').value;
    const hint = document.getElementById('builderHint').value;
    const reqStr = document.getElementById('builderReq').value;
    const sampleSolution = document.getElementById('builderSolution').value;
    
    if(!courseId || courseId === 'new') return alert("Please select a valid course.");
    if(!moduleName || !title || !question || !reqStr || !sampleSolution) return alert("Please fill all required fields.");
    
    // We get current orderIndex by fetching stages length
    const resStages = await fetch('/api/admin/students');
    const dataStages = await resStages.json();
    const orderIndex = dataStages.totalStages;
    
    const requiredElements = reqStr.split(',').map(s => s.trim());
    
    const res = await fetch('/api/stages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        courseId: parseInt(courseId),
        module: moduleName,
        title, question, hint, requiredElements, sampleSolution, orderIndex
      })
    });
    const data = await res.json();
    if(data.success) {
      alert('New stage/lesson added successfully!');
      // Clear fields
      document.getElementById('builderTitle').value = '';
      document.getElementById('builderQuestion').value = '';
      document.getElementById('builderReq').value = '';
      document.getElementById('builderSolution').value = '';
    } else {
      alert('Failed to add stage: ' + (data.error?.message || 'Unknown error'));
    }
  }

