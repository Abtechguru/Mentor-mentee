    .cert-course { font-size: 24px; color: #38bdf8; font-weight: bold; margin: 15px 0 30px 0; }
    
    .cert-footer { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 40px; padding: 0 20px; }
    .cert-sig-block { text-align: center; }
    .cert-sig { font-family: 'Brush Script MT', cursive; font-size: 32px; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.3); padding: 0 20px; margin-bottom: 5px; line-height: 0.8; }
    .cert-seal { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #bf953f, #aa771c); display: flex; justify-content: center; align-items: center; box-shadow: 0 5px 15px rgba(0,0,0,0.5); position: relative; }
    .cert-seal::after { content: '★'; color: white; font-size: 35px; }
    .cert-seal::before { content:''; position:absolute; width:100%; height:100%; border:2px dashed rgba(255,255,255,0.5); border-radius:50%; box-sizing:border-box; }
    
    .cert-id { position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); font-size: 11px; color: #64748b; font-family: monospace; }
    
    .cert-actions { display: flex; gap: 15px; padding: 20px; background: rgba(0,0,0,0.2); border-top: 1px solid rgba(255,255,255,0.05); justify-content: center; flex-wrap: wrap; }
    .cert-btn { padding: 10px 20px; border-radius: 8px; border: none; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; transition: all 0.2s; }
    .cert-btn-primary { background: linear-gradient(135deg, #10b981, #059669); color: white; }
    .cert-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(16, 185, 129, 0.4); }
    .cert-btn-secondary { background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2); }
    .cert-btn-secondary:hover { background: rgba(255,255,255,0.2); }
    
    .cert-close { position: absolute; top: 15px; right: 20px; font-size: 24px; color: #94a3b8; cursor: pointer; z-index: 10; transition: color 0.2s; font-weight: bold; }
    .cert-close:hover { color: #fff; }
    
    @media (max-width: 600px) {
      .cert-name { font-size: 32px; padding: 0 10px 5px 10px; }
      .cert-title { font-size: 28px; }
      .cert-course { font-size: 18px; }
      .cert-footer { flex-direction: column; align-items: center; gap: 30px; }
      .cert-seal { order: -1; }
    }
    
    @media print {
      body * { visibility: hidden; }
      .cert-overlay, .cert-modal, .cert-frame, .cert-frame * { visibility: visible; }
